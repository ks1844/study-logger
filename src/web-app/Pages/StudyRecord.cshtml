@page
@model web_app.Pages.StudyRecordModel
@{
    ViewData["Title"] = "学習記録一覧";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>学習記録一覧</h1>
            <a href="/Dashboard" class="btn btn-secondary">ダッシュボードに戻る</a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
                新規学習記録作成
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    @if (Model.StudyRecords.Any())
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>日付</th>
                                    <th>カテゴリ</th>
                                    <th>学習時間</th>
                                    <th>メモ</th>
                                    <th style="width: 150px;">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.StudyRecords)
                                {
                                    <tr>
                                        <td>@record.Date.ToString("yyyy/MM/dd")</td>
                                        <td><span class="badge bg-info">@record.CategoryName</span></td>
                                        <td>@record.StudyHour 時間</td>
                                        <td>@(record.Memo ?? "-")</td>
                                        <td>
                                            <button class="btn btn-sm btn-warning" 
                                                    onclick="openEditModal(@record.Id, '@record.Date.ToString("yyyy-MM-dd")', @record.CategoryId, @record.StudyHour, '@(record.Memo ?? "")')">
                                                編集
                                            </button>
                                            <form method="post" asp-page-handler="Delete" style="display:inline;">
                                                <input type="hidden" name="id" value="@record.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger" 
                                                        onclick="return confirm('削除してもよろしいですか?')">
                                                    削除
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">学習記録がまだありません。新規作成してください。</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 作成モーダル -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">学習記録作成</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="Date" class="form-label">日付</label>
                        <input type="date" class="form-control" id="Date" name="Date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label for="CategoryId" class="form-label">カテゴリ</label>
                        <select class="form-control" id="CategoryId" name="CategoryId" required>
                            <option value="">選択してください</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="StudyHour" class="form-label">学習時間（時間）</label>
                        <input type="number" step="0.5" class="form-control" id="StudyHour" name="StudyHour" min="0.5" max="24" required />
                    </div>
                    <div class="mb-3">
                        <label for="Memo" class="form-label">メモ</label>
                        <textarea class="form-control" id="Memo" name="Memo" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 編集モーダル -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <div class="modal-header">
                    <h5 class="modal-title">学習記録編集</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="EditRecordId" name="EditRecordId" />
                    <div class="mb-3">
                        <label for="EditDate" class="form-label">日付</label>
                        <input type="date" class="form-control" id="EditDate" name="Date" required />
                    </div>
                    <div class="mb-3">
                        <label for="EditCategoryId" class="form-label">カテゴリ</label>
                        <select class="form-control" id="EditCategoryId" name="CategoryId" required>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="EditStudyHour" class="form-label">学習時間（時間）</label>
                        <input type="number" step="0.5" class="form-control" id="EditStudyHour" name="StudyHour" min="0.5" max="24" required />
                    </div>
                    <div class="mb-3">
                        <label for="EditMemo" class="form-label">メモ</label>
                        <textarea class="form-control" id="EditMemo" name="Memo" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
                    <button type="submit" class="btn btn-primary">更新</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditModal(id, date, categoryId, studyHour, memo) {
        document.getElementById('EditRecordId').value = id;
        document.getElementById('EditDate').value = date;
        document.getElementById('EditCategoryId').value = categoryId;
        document.getElementById('EditStudyHour').value = studyHour;
        document.getElementById('EditMemo').value = memo;
        var modal = new bootstrap.Modal(document.getElementById('editModal'));
        modal.show();
    }
</script>
}
