@page
@model web_app.Pages.LoginModel
@{
    ViewData["Title"] = "ログイン";
}

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Study Logger</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h2 class="text-center">学習記録アプリ ログイン</h2>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger">@Model.ErrorMessage</div>
                        }
                        
                        <form method="post">
                            <div class="mb-3">
                                <label for="Email" class="form-label">メールアドレス</label>
                                <input type="email" class="form-control" id="Email" name="Email" required />
                            </div>
                            <div class="mb-3">
                                <label for="Password" class="form-label">パスワード</label>
                                <input type="password" class="form-control" id="Password" name="Password" required />
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">ログイン</button>
                            </div>
                        </form>
                        
                        <div class="mt-3">
                            <p class="text-muted small">デモ用アカウント:</p>
                            <ul class="text-muted small">
                                <li>学習者: student@example.com / password</li>
                                <li>管理者: admin@example.com / password</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
