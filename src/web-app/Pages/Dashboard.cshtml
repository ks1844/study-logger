@page
@model web_app.Pages.DashboardModel
@{
    ViewData["Title"] = "ダッシュボード";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            @if (Model.IsReadOnly)
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h1>ダッシュボード (閲覧モード)</h1>
                        <p>閲覧中の学生: <strong>@Model.ViewingStudentName</strong>さん</p>
                    </div>
                    <div>
                        <a href="/StudentSelect" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> 学生選択に戻る
                        </a>
                    </div>
                </div>
                <div class="alert alert-info">
                    <i class="bi bi-eye"></i> 管理者として閲覧しています。編集はできません。
                </div>
            }
            else
            {
                <h1>ダッシュボード</h1>
                <p>ようこそ、<strong>@Model.UserName</strong>さん (@Model.UserRole)</p>
            }
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">今日の学習時間</h5>
                    <h2 class="text-primary">@Model.Dashboard.TodayStudyHours 時間</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">今月の学習時間</h5>
                    <h2 class="text-success">@Model.Dashboard.MonthStudyHours 時間</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>最近の学習記録</h5>
                </div>
                <div class="card-body">
                    @if (Model.Dashboard.RecentRecords.Any())
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>日付</th>
                                    <th>カテゴリ</th>
                                    <th>学習時間</th>
                                    <th>メモ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.Dashboard.RecentRecords)
                                {
                                    <tr>
                                        <td>@record.Date.ToString("yyyy/MM/dd")</td>
                                        <td><span class="badge bg-info">@record.CategoryName</span></td>
                                        <td>@record.StudyHour 時間</td>
                                        <td>@(record.Memo ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">まだ学習記録がありません</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!Model.IsReadOnly)
    {
        <div class="row mb-4">
            <div class="col-md-3 mb-2">
                <a href="/StudyRecord" class="btn btn-primary w-100">学習記録一覧</a>
            </div>
            <div class="col-md-3 mb-2">
                <a href="/Category" class="btn btn-secondary w-100">カテゴリ一覧</a>
            </div>
            <div class="col-md-3 mb-2">
                <a href="/DailyReport" class="btn btn-info w-100">日報一覧</a>
            </div>
            <div class="col-md-3 mb-2">
                <button class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#prGenerateModal">PR生成</button>
            </div>
        </div>
    }
</div>

@if (!Model.IsReadOnly)
{
    <!-- PR生成モーダル (仮実装) -->
    <div class="modal fade" id="prGenerateModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">PR生成</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>PR生成機能は準備中です</p>
                </div>
            </div>
        </div>
    </div>
}
